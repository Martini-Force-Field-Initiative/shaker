title                    = Martini

refcoord_scaling         = com
integrator               = md
dt                       = 0.020 ;ps
nsteps                   = 10000000 ; 200 ns
nstcomm                  = 100
comm-grps		         = System

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1000000 
nstenergy                = 1000    
nstxtcout                = 1000   
xtc_precision            = 100
xtc-grps                 = 

cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1
ns_type                  = grid
pbc                      = xyz

coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15 	
epsilon_rf               = 0 
vdw_type                 = cutoff 
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1 

tcoupl                   = v-rescale 
tc-grps                  = System
tau_t                    = 1.0  
ref_t                    = 300  
Pcoupl                   = Parrinello-Rahman
Pcoupltype               = isotropic
tau_p                    = 12.0  
compressibility          = 3e-4      
ref_p                    = 1.0       

continuation		     = yes
gen_vel                  = no
gen_temp                 = 300
gen_seed                 = -1

constraints              = none 
constraint_algorithm     = Lincs
lincs_order              = 4
lincs_iter               = 1
lincs_warnangle          = 90
